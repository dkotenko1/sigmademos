# Secrets — never commit
.env
.env.*
*.pem
/tmp/.sigma_token

# Upstream skill mirror (cloned on demand by scripts/refresh-vendor.sh)
vendor/

# OS / editor junk
.DS_Store
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.pyc

# Local Netlify folder
.netlify

# demo.py --copy outputs (never the tracked workbook ids)
skills/*/specs/workbook_id_copy_*
skills/*/shots/*-copy/
!.env.example
