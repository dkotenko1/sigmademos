# Copy to .env (gitignored) and fill in. `python3 scripts/doctor.py` checks all of it.

# sigma CLI profile (see `sigma auth login`). Leave blank to use the CLI's default profile.
SIGMA_CLI_PROFILE=

# A WRITE-capable warehouse connection id — the whole workbook runs on one connection
# (input tables need write access). List yours: sigma api connections list
SIGMA_CONNECTION_ID=

# Destination folder id for new workbooks/reports (e.g. My Documents / Claude Demos).
# Find it: sigma api files list --params '{"typeFilters":["folder"],"limit":200}'
SIGMA_FOLDER_ID=

# Your organization id (sigma api whoami get -> organizationId). Used only for guards.
SIGMA_ORG_ID=

# Optional: path to the sigma binary if it is not ~/.sigma-cli/bin/sigma
# SIGMA_CLI_BIN=
